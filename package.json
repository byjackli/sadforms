{
  "name": "sadforms",
  "version": "0.0.5",
  "description": "Sad Forms - low-level accessible forms designed for Svelte programmers.",
  "license": "Apache-2.0",
  "author": "Jack Li",
  "homepage": "https://sadforms.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/byjackli/sadforms"
  },
  "bugs": {
    "url": "https://github.com/byjackli/sadforms/issues"
  },
  "keywords": [
    "svelte",
    "forms",
    "validation",
    "form-validation"
  ],
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "package": "svelte-kit sync && svelte-package",
    "preview": "vite preview --host",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:unit": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest --coverage",
    "test:all": "npm run test:unit && npm run test"
  },
  "main": "./components/Form.svelte",
  "exports": {
    ".": "./components/Form.svelte"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.1",
    "@sveltejs/adapter-auto": "^3.3.1",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.25.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.8",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/ui": "^3.2.4",
    "eslint": "^8.57.1",
    "eslint-plugin-svelte": "^3.10.1",
    "firebase": "^9.6.8",
    "jsdom": "^26.1.0",
    "svelte": "^5.36.10",
    "svelte-check": "^4.3.0",
    "svelte-eslint-parser": "^1.3.0",
    "svelte2tsx": "^0.7.41",
    "tslib": "^2.3.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "svelte": "^5.36.10"
  },
  "typings": "./types/Form.d.ts",
  "type": "module",
  "dependencies": {
    "playwright": "^1.54.1"
  }
}
